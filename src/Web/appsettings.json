{
  "ConnectionStrings": {
    "smart-routes-db": "Server=(localdb)\\mssqllocaldb;Database=smart-routes-db;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "SmartRoutes",
    "Audience": "SmartRoutes",
    "Key": "smart-routes-development-key-change-me-1234567890",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Maps": {
    "OsrmBaseUrl": "https://router.project-osrm.org",
    "OsrmProfile": "driving",
    "NominatimBaseUrl": "https://nominatim.openstreetmap.org",
    "GeocodingCountryCodes": "cu",
    "UserAgent": "SmartRoutes/1.0 (proyecto universitario)",
    "TimeoutSeconds": 25,
    "FallbackRoadFactor": 1.3,
    "FallbackSpeedKmh": 30,
    "CacheMinutes": 60
  }
}
