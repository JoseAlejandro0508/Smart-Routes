# Plantilla de variables de entorno del frontend.
# Copia este archivo como .env.development (git lo ignora) y ajusta si hace falta.

# URL base de la API. En desarrollo Vite la proxea según vite.config.ts.
VITE_API_URL=/api

# Activa MSW: la app responde con datos simulados (contrato en src/mocks/)
# sin necesidad de que el backend esté corriendo.
# Ponla en false cuando quieras apuntar al backend real.
VITE_ENABLE_MOCKS=true
